{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text Replacer",
  "version": "1.4.1",
  "identifier": "dev.textreplacer.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Text Replacer",
        "width": 1180,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRTAzNEEwQTk1QzA5NzkKUldSNUNWeXBvRFRnL2tCbkRpQmNBNXhVUHc5bUFCMHM2ZDNtOUZKTjFnOElzZ3duazhScW9YVEQK",
      "endpoints": [
        "https://github.com/Pavel-us/TextReplacer/releases/latest/download/latest.json"
      ]
    }
  }
}
